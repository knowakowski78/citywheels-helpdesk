# Local default. PowerShell: $env:OLLAMA_MODEL = 'qwen3:8b'
# This file is a template; the program reads environment variables, not .env files.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_THINK=false
OLLAMA_NUM_GPU=-1
# Retained small profile: model=qwen3:0.6b, think=true, num_gpu=0.
# Local Ollama requires no key. For an authenticated endpoint set this in your environment.
OLLAMA_API_KEY=

# Optional API backup; used only with --provider groq.
# Prefer keeping the actual key in ignored .env.groq, read with --env-file .env.groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
